%YAML 1.2
---
name: Rhai
file_extensions:
  - rhai
scope: source.rhai
contexts:
  main:
    - match: '//.*$'
      scope: comment.line.double-slash.rhai
    - match: '/\*'
      scope: punctuation.definition.comment.rhai
      push: block_comment
    - match: '\b(let|const|fn|if|else|while|loop|for|in|break|continue|return|import|export|as|try|catch|throw|switch|default|private|do|until)\b'
      scope: keyword.control.rhai
    - match: '\b(true|false)\b'
      scope: constant.language.rhai
    - match: '\(\)'
      scope: constant.language.rhai
    - match: '\b(this|global)\b'
      scope: variable.language.rhai
    - match: '#\{'
      scope: punctuation.definition.map.begin.rhai
    - match: '::'
      scope: punctuation.accessor.rhai
    - match: '"'
      scope: punctuation.definition.string.begin.rhai
      push: double_string
    - match: "'"
      scope: punctuation.definition.string.begin.rhai
      push: single_string
    - match: '`'
      scope: punctuation.definition.string.begin.rhai
      push: template_string
    - match: '\b0x[0-9A-Fa-f_]+\b'
      scope: constant.numeric.hex.rhai
    - match: '\b0b[01_]+\b'
      scope: constant.numeric.binary.rhai
    - match: '\b\d[\d_]*(\.\d[\d_]*)?([eE][+-]?\d+)?\b'
      scope: constant.numeric.rhai
    - match: '(?<![A-Za-z0-9_])\.\d[\d_]*([eE][+-]?\d+)?\b'
      scope: constant.numeric.rhai
    - match: '\b(print|debug|type_of|to_string|len|push|pop|shift|unshift|range|Fn|call|curry|is_def_var|is_def_fn|is_shared|eval|parse_int|parse_float|to_int|to_float|to_blob|to_array|to_map)\b'
      scope: support.function.builtin.rhai
    - match: '\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()'
      scope: entity.name.function.rhai
    - match: '\b[A-Za-z_][A-Za-z0-9_]*\b'
      scope: variable.other.rhai
    - match: '(\+=|\-=|\*=|\/=|==|!=|<=|>=|<<|>>|&&|\|\||\.\.=|\.\.|\?\?|\?\.|\+|\-|\*|\/|%|<|>|!|=|&|\||\^|~)'
      scope: keyword.operator.rhai
  block_comment:
    - meta_scope: comment.block.rhai
    - match: '/\*'
      push: block_comment
    - match: '\*/'
      scope: punctuation.definition.comment.rhai
      pop: true
  double_string:
    - meta_scope: string.quoted.double.rhai
    - match: '\\.'
      scope: constant.character.escape.rhai
    - match: '"'
      scope: punctuation.definition.string.end.rhai
      pop: true
  single_string:
    - meta_scope: string.quoted.single.char.rhai
    - match: "\\\\."
      scope: constant.character.escape.rhai
    - match: "'"
      scope: punctuation.definition.string.end.rhai
      pop: true
  template_string:
    - meta_scope: string.quoted.other.rhai
    - match: '\\.'
      scope: constant.character.escape.rhai
    - match: '\$\{'
      scope: punctuation.section.embedded.begin.rhai
      push: template_interpolation
    - match: '`'
      scope: punctuation.definition.string.end.rhai
      pop: true
  template_interpolation:
    - meta_scope: meta.embedded.expression.rhai
    - match: '\}'
      scope: punctuation.section.embedded.end.rhai
      pop: true
    - match: '\{'
      push: template_interp_brace
    - include: main
  template_interp_brace:
    - match: '\}'
      pop: true
    - match: '\{'
      push: template_interp_brace
    - include: main
